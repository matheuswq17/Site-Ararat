# Apenas código do site e fontes de animação selecionadas entram no repositório público.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/site/
!/motion/

/site/node_modules/
/site/.next*/
/site/screenshots/
/site/media-fontes/
/site/.vercel/
/site/.env*
/site/*.tsbuildinfo

/motion/*
!/motion/package.json
!/motion/package-lock.json
!/motion/src/
!/motion/scripts/
!/motion/proposta/
/motion/proposta/*
!/motion/proposta/home-montanha-b/
!/motion/proposta/time-interativo/
!/motion/proposta/topo-revisao/
!/motion/proposta/plataforma-fluxo/
/motion/proposta/home-montanha-b/*
!/motion/proposta/home-montanha-b/src/
!/motion/proposta/home-montanha-b/geometry/
/motion/proposta/time-interativo/*
!/motion/proposta/time-interativo/src/
/motion/proposta/topo-revisao/*
!/motion/proposta/topo-revisao/src/
!/motion/proposta/topo-revisao/geometry/
/motion/proposta/plataforma-fluxo/*
!/motion/proposta/plataforma-fluxo/src/
!/motion/proposta/plataforma-fluxo/geometria/

**/node_modules/
**/__pycache__/
**/.env*
**/*.pem
**/*.key
**/*.tgz
**/*.zip
**/*.mp4
**/*.webm
**/*.pdf

